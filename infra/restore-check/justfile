# Recipes for the restore checks (TEC-1987), loaded by the root justfile
# as the `restore-check` module: run them from the project root as
# `just restore-check <recipe>`. Recipes execute with this directory as
# their working directory.

# Trigger the monthly DB restore check by hand (runs in AWS, ~10 minutes)
db:
    #!/usr/bin/env bash
    set -euo pipefail
    aws lambda invoke --region ap-southeast-2 \
        --function-name restore-check-db:live \
        --invocation-type Event --no-cli-pager /dev/null
    echo "Restore check launched: the result lands in Slack. Follow along in"
    echo "the Lambda console (restore-check-db > Durable executions) or the"
    echo "CloudWatch log group /restore-check/db."

# Build and push the DB restore check image to ECR (this deploys the check)
db-image:
    #!/usr/bin/env bash
    set -euo pipefail
    region="ap-southeast-2"
    account=$(aws sts get-caller-identity --query Account --output text)
    registry="$account.dkr.ecr.$region.amazonaws.com"
    # Fargate runs x86_64; pin the platform so builds from ARM machines work.
    docker build --platform linux/amd64 \
        --file Dockerfile.database \
        --tag "$registry/restore-check-db:latest" .
    aws ecr get-login-password --region "$region" \
        | docker login --username AWS --password-stdin "$registry"
    docker push "$registry/restore-check-db:latest"
