{
  "name": "clerk-web",
  "version": "1.0.0",
  "description": "DaisyUI styling for Clerk web app",
  "scripts": {
    "build:css": "mkdir -p /dist/web/styles && npx @tailwindcss/cli -i src/input.css -o /dist/web/styles/daisyui.css --minify",
    "watch:css": "mkdir -p /dist/web/styles && npx @tailwindcss/cli -i src/input.css -o /dist/web/styles/daisyui.css --watch=always",
    "build:js": "bash scripts/build-js.sh",
    "build": "npm run build:css && npm run build:js",
    "watch": "npm run build:js && npm run watch:css"
  },
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "glightbox": "^3.3.1",
    "htmx.org": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "daisyui": "^5.5.19",
    "tailwindcss": "^4.2.2"
  }
}
